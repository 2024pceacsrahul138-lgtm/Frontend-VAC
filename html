                            <b>Solatium</b>
                            <small>Imber Sun</small>
                        </div>
                    </div>

                    <span>Solatium</span>
                    <span>1 week ago</span>
                    <span>2:06</span>
                </div>


                <div class="song">
                    <span>4</span>

                    <div class="song-title">
                        <div class="song-img purple"></div>
                        <div>
                            <b>Efflorescence</b>
                            <small>Far & Beyond</small>
                        </div>
                    </div>

                    <span>Efflorescence</span>
                    <span>1 week ago</span>
                    <span>2:23</span>
                </div>


                <div class="song">
                    <span>5</span>

                    <div class="song-title">
                        <div class="song-img pink"></div>
                        <div>
                            <b>Gather My Thoughts</b>
                            <small>Josef Briem</small>
                        </div>
                    </div>

                    <span>Gather My Thoughts</span>
